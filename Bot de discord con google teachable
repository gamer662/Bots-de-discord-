@bot.command()
async def cclasificar(ctx, image_attachment: discord.Attachment): # CAMBIO 2: Renombrado por claridad
    if image_attachment.content_type.startswith('image/'):
        await ctx.send(f'Clasificando la imagen {image_attachment.filename}...')
        # Deshabilitar la notación científica para mayor claridad
        np.set_printoptions(suppress=True)

        # Cargando el modelo
        model = load_model("keras_model.h5", compile=False)

        # Cargando las etiquetas
        class_names = open("labels.txt", "r").readlines()

        # Creación de la matriz con la forma correcta para alimentar el modelo Keras
        data = np.ndarray(shape=(1, 224, 224, 3), dtype=np.float32)

        # CAMBIO 3: Descargar la imagen de Discord y convertirla a formato PIL
        image_bytes = await image_attachment.read()
        pil_image = Image.open(io.BytesIO(image_bytes)).convert("RGB")

        # Redimensionar la imagen para que tenga al menos 224x224px y luego recortarla desde el centro
        size = (224, 224)
        processed_image = ImageOps.fit(pil_image, size, Image.Resampling.LANCZOS) # CAMBIO 4: Usar la imagen PIL

        # Convertir la imagen en una matriz NumPy
        image_array = np.asarray(processed_image)

        # Normalizando la imagen
        normalized_image_array = (image_array.astype(np.float32) / 127.5) - 1

        # Cargando la imagen dentro del array
        data[0] = normalized_image_array

        # Prediciendo con el modelo
        prediction = model.predict(data)
        index = np.argmax(prediction)
        class_name = class_names[index]
        confidence_score = prediction[0][index]
        if confidence_score >= 50.0:
            await ctx.send(f'¡Clasificación completada! La imagen es un {class_name.strip()} con una puntuación de confianza del {confidence_score:.2f}.')
        elif confidence_score < 50.0:
            await ctx.send('La puntuación de confianza es baja, por favor, envía otra imagen para una mejor clasificación.')
    else:
        await ctx.send('Por favor, envía una imagen válida.')

